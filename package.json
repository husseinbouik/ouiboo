{
    "name":  "ouiboo-monorepo",
    "private":  true,
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "turbo dev",
                    "build":  "turbo build",
                    "lint":  "turbo lint",
                    "test":  "turbo test",
                    "test:e2e":  "playwright test",
                    "test:e2e:install":  "playwright install --with-deps chromium",
                    "prepare":  "husky install",
                    "ci":  "npm run lint \u0026\u0026 npm run test",
                    "install:ci":  "npm install --no-audit --no-fund",
                    "check:env":  "node scripts/validate-env.mjs",
                    "check:placeholders":  "node scripts/check-placeholders.mjs",
                    "check:prod":  "npm run check:env \u0026\u0026 npm run check:placeholders \u0026\u0026 npm run build",
                    "seed:demo":  "node scripts/seed-demo.mjs",
                    "demo:prepare":  "node scripts/prepare-demo.mjs",
                    "demo:start":  "node scripts/demo-processes.mjs start",
                    "demo:status":  "node scripts/demo-processes.mjs status",
                    "demo:smoke":  "node scripts/smoke-deploy.mjs",
                    "demo:stop":  "node scripts/demo-processes.mjs stop"
                },
    "devDependencies":  {
                            "@playwright/test":  "^1.59.1",
                            "dotenv":  "^17.2.3",
                            "husky":  "^8.0.0",
                            "turbo":  "latest",
                            "zod":  "^4.3.5"
                        },
    "packageManager":  "npm@10.0.0"
}
