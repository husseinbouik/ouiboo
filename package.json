{
    "name": "ouiboo-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "install:ci": "rm -rf node_modules && npm cache clean --force && npm ci --no-audit --no-fund --prefer-online"
    },
    "devDependencies": {
        "turbo": "latest"
    },
    "packageManager": "npm@10.0.0"
}
