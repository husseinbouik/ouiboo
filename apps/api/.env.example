JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
TRUST_PROXY_HOPS=1
DATABASE_URL=postgres://user:password@localhost:5432/ouiboo
API_URL=http://localhost:3000/api/v1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
APP_BASE_URL=http://localhost:3000
TRAVELER_APP_URL=http://localhost:3000
AGENCY_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
ADMIN_SEED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@ouiboo.local
ADMIN_SEED_ROTATE=false
AUDIT_LOG_RETENTION_DAYS=90
PAYMENT_PROOF_EXPIRATION_HOURS=24
STORAGE_PROVIDER=local
S3_PUBLIC_URL=
REDIS_URL=redis://localhost:6379
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_MAX_AGE_MS=45000
ENABLE_SWAGGER=true
ENABLE_GATEWAY_PAYMENTS=false

# Feature flags / kill switches (#254) — env-based, fail-closed.
# Set FEATURE_<NAME>=true to enable. Unset or anything else = disabled.
FEATURE_NEW_CHECKOUT=false

# Public base URL of this API (used to build links in emails, e.g. unsubscribe)
API_PUBLIC_URL=https://ouiboo-api.vercel.app
# Physical postal address printed in marketing email footers (#322).
# Marketing sends are blocked until this is set.
OUIBOO_POSTAL_ADDRESS=
# Optional dedicated secret for unsubscribe tokens (falls back to JWT_SECRET)
UNSUBSCRIBE_SECRET=

# Ouiboo legal issuer details printed on platform service fee invoices (#359).
# Left empty until the company is registered; invoices then carry no ICE/RC
# and never a placeholder. Values are snapshotted onto each issued invoice.
OUIBOO_LEGAL_NAME=
OUIBOO_LEGAL_ICE=
OUIBOO_LEGAL_RC=
OUIBOO_LEGAL_ADDRESS=
# Default platform service fee rate (percent) for monthly agency invoices
# (#359). Generation fails closed when neither this nor a per-request rate
# is provided.
OUIBOO_COMMISSION_RATE_PERCENT=
