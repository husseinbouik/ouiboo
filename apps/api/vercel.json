{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../../packages/database && npx prisma generate && cd ../../apps/api && npm run build && mkdir -p public && echo 'ok' > public/health.txt",
  "ignoreCommand": "bash -c '[ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"staging\" ]'",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "../../node_modules/pdfkit/js/standard-fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/maintenance",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/cron/deadlines",
      "schedule": "0 * * * *"
    }
  ],
  "installCommand": "npm install --prefix ../..",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api"
    }
  ]
}
