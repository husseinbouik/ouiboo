{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../../packages/database && npx prisma generate && cd ../../apps/api && npm run build && mkdir -p public && echo 'ok' > public/health.txt",
  "ignoreCommand": "bash -c '[ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"staging\" ]'",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm install --prefix ../..",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api"
    }
  ]
}