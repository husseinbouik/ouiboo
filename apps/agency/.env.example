NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_MEDIA_URL=http://localhost:3000/uploads

# Public origin of the TRAVELLER app - agency share actions (#468) link to
# the public traveller trip pages. Localhost suits local development only;
# deployed environments MUST set the traveller app's real public URL.
NEXT_PUBLIC_TRAVELER_URL=http://localhost:3001

# Council B12: trip sharing (share buttons + rich trip previews). Keep unset/false
# for the closed beta; set to true only at public launch.
NEXT_PUBLIC_SHARING_ENABLED=false
