DATABASE_URL=postgresql://ouiboo:replace-with-db-password@db.example.com:5432/ouiboo
JWT_SECRET=replace-with-a-long-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
CORS_ORIGINS=https://app.example.com,https://agency.example.com,https://admin.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
TRAVELER_APP_URL=https://app.example.com
AGENCY_APP_URL=https://agency.example.com
ADMIN_APP_URL=https://admin.example.com
NEXT_PUBLIC_TRAVELER_URL=https://app.example.com
NEXT_PUBLIC_AGENCY_URL=https://agency.example.com
STORAGE_PROVIDER=s3
S3_BUCKET=ouiboo-production
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_ENDPOINT=https://s3.example.com
REDIS_URL=redis://redis.example.com:6379
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_MAX_AGE_MS=45000
ENABLE_SWAGGER=false
GMAIL_EMAIL=waitlist@example.com
GMAIL_APP_PASSWORD=replace-with-app-password
GOOGLE_SERVICE_ACCOUNT_EMAIL=waitlist-writer@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=replace-with-service-account-private-key
GOOGLE_SHEET_ID=replace-with-sheet-id
