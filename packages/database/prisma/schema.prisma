generator client {
  provider = "prisma-client-js"
  output   = "../generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENCY
  TRAVELER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TripStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum TripCategory {
  ADVENTURE
  CULTURAL
  LUXURY
  BUDGET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  PENDING_PAYMENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String
  role          UserRole       @default(TRAVELER)
  avatar        String?
  isEmailVerified Boolean     @default(false)
  otp           String?
  otpExpiresAt  DateTime?
  agencyProfile AgencyProfile?
  bookings      Booking[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AgencyProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  companyName        String
  ice                String             @unique
  patente            String
  rib                String
  verificationStatus VerificationStatus @default(PENDING)
  bio                String?
  logo               String?
  templates          TripTemplate[]
  wallet             Wallet?
  payoutRequests     PayoutRequest[]
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  bankDetails        String?            @db.Text
}

model TripTemplate {
  id             String        @id @default(cuid())
  agencyId       String
  agency         AgencyProfile @relation(fields: [agencyId], references: [id])
  title          String
  description    String
  category       TripCategory
  startLocation  String
  durationDays   Int
  durationNights Int
  inclusions     String[]
  exclusions     String[]
  checklist      String[]
  images         String[]
  status         TripStatus    @default(DRAFT)
  featured       Boolean       @default(false)
  sessions       TripSession[]
  itinerary      ItineraryDay[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ItineraryDay {
  id          String       @id @default(cuid())
  templateId  String
  template    TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String?
  description String
  activities  String[]
}

model TripSession {
  id             String       @id @default(cuid())
  templateId     String
  template       TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  price          Float
  deposit        Float        @default(0)
  totalSeats     Int
  availableSeats Int
  status         String       @default("OPEN")
  bookings       Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  sessionId      String
  session        TripSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  travelerId     String
  traveler       User          @relation(fields: [travelerId], references: [id])
  bookingDate    DateTime      @default(now())
  status         BookingStatus @default(PENDING)
  totalAmount    Float
  guestsCount    Int
  paymentProofId String?       @unique
  paymentProof   PaymentProof?
}

model PaymentProof {
  id         String     @id @default(cuid())
  bookingId  String     @unique
  booking    Booking    @relation(fields: [bookingId], references: [id])
  imageUrl   String
  uploadedAt DateTime   @default(now())
  status     VerificationStatus @default(PENDING)
}

model Wallet {
  id               String              @id @default(cuid())
  agencyId         String              @unique
  agency           AgencyProfile       @relation(fields: [agencyId], references: [id])
  availableBalance Float               @default(0)
  pendingBalance   Float               @default(0)
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id        String          @id @default(cuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  amount    Float
  type      TransactionType
  reason    String
  createdAt DateTime        @default(now())
}

model PayoutRequest {
  id          String       @id @default(cuid())
  agencyId    String
  agency      AgencyProfile @relation(fields: [agencyId], references: [id])
  amount      Float
  status      PayoutStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  bankDetails String
}
