generator client {
  provider = "prisma-client-js"
  output   = "../generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENCY
  TRAVELER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TripStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum TripCategory {
  ADVENTURE
  CULTURAL
  LUXURY
  BUDGET
}

enum BookingStatus {
  PENDING
  AWAITING_VALIDATION
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  PAYMENT_GATEWAY
  BOOKING
}

enum PaymentMethod {
  MANUAL
  GATEWAY
}

enum NotificationType {
  PAYMENT_REMINDER
  TRIP_REMINDER
  BOOKING_CONFIRMATION
  CANCELLATION
  REVIEW_REQUEST
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum BookingPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum SessionStatus {
  OPEN
  FULL
  CANCELLED
}

model User {
  id                      String                  @id @default(cuid())
  name                    String?
  email                   String                  @unique
  password                String
  role                    UserRole                @default(TRAVELER)
  avatar                  String?
  isEmailVerified         Boolean                 @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  otpLastSentAt           DateTime?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  passwordResetSentAt     DateTime?
  refreshTokens           RefreshToken[]
  agencyProfile           AgencyProfile?
  bookings                Booking[]
  reviews                 Review[]
  wishlist                Wishlist[]
  notificationPreferences NotificationPreference?
  displayCurrency         String                  @default("MAD")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model RefreshToken {
  id                String         @id @default(cuid())
  tokenHash         String         @unique
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
}

model AgencyProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  companyName        String
  ice                String             @unique
  patente            String
  rib                String
  verificationStatus VerificationStatus @default(PENDING)
  bio                String?
  logo               String?
  templates          TripTemplate[]
  wallet             Wallet?
  payoutRequests     PayoutRequest[]
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  bankDetails        String?            @db.Text
}

model TripTemplate {
  id                 String         @id @default(cuid())
  agencyId           String
  agency             AgencyProfile  @relation(fields: [agencyId], references: [id])
  title              String
  description        String
  category           TripCategory
  startLocation      String
  durationDays       Int
  durationNights     Int
  inclusions         String[]
  exclusions         String[]
  checklist          String[]
  images             String[]
  status             TripStatus     @default(DRAFT)
  featured           Boolean        @default(false)
  sessions           TripSession[]
  itinerary          ItineraryDay[]
  reviews            Review[]
  wishlists          Wishlist[]
  averageRating      Float?
  reviewCount        Int            @default(0)
  lastReviewDate     DateTime?
  cancellationPolicy Json?
  minBookings        Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ItineraryDay {
  id          String       @id @default(cuid())
  templateId  String
  template    TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String?
  description String
  activities  String[]
}

model TripSession {
  id                 String        @id @default(cuid())
  templateId         String
  template           TripTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime
  price              Float
  deposit            Float         @default(0)
  totalSeats         Int
  availableSeats     Int
  status             SessionStatus @default(OPEN)
  bookings           Booking[]
  currency           String        @default("MAD")
  cancellationReason String?
  minBookings        Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([startDate])
  @@index([endDate])
}

model Booking {
  id                          String               @id @default(cuid())
  sessionId                   String
  session                     TripSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  travelerId                  String
  traveler                    User                 @relation(fields: [travelerId], references: [id])
  bookingDate                 DateTime             @default(now())
  status                      BookingStatus        @default(PENDING)
  totalAmount                 Float
  guestsCount                 Int
  fullName                    String?
  phoneNumber                 String?
  documentNumber              String?
  paymentProofUrl             String?
  paymentProofId              String?              @unique
  paymentProof                PaymentProof?
  paymentMethod               PaymentMethod        @default(MANUAL)
  paymentGatewayTransactionId String?
  paymentGatewayMetadata      Json?
  paymentStatus               BookingPaymentStatus @default(UNPAID)
  lastReminderSentAt          DateTime?
  notificationsSent           Json?
  cancelledAt                 DateTime?
  cancelledBy                 String?
  cancellationReason          String?
  confirmedAt                 DateTime?
  refundAmount                Float?
  refundStatus                RefundStatus?
  refundProcessedAt           DateTime?
  review                      Review?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([travelerId])
  @@index([sessionId])
  @@index([status])
}

model PaymentProof {
  id              String             @id @default(cuid())
  bookingId       String             @unique
  booking         Booking            @relation(fields: [bookingId], references: [id])
  imageUrl        String
  uploadedAt      DateTime           @default(now())
  rejectionReason String?
  status          VerificationStatus @default(PENDING)
}

model Wallet {
  id               String              @id @default(cuid())
  agencyId         String              @unique
  agency           AgencyProfile       @relation(fields: [agencyId], references: [id])
  availableBalance Float               @default(0)
  pendingBalance   Float               @default(0)
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  amount      Float
  type        TransactionType
  reason      String
  referenceId String?
  createdAt   DateTime        @default(now())
}

model PayoutRequest {
  id          String        @id @default(cuid())
  agencyId    String
  agency      AgencyProfile @relation(fields: [agencyId], references: [id])
  amount      Float
  status      PayoutStatus  @default(PENDING)
  requestedAt DateTime      @default(now())
  processedAt DateTime?
  bankDetails String
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType])
}

// Reviews & Ratings
model Review {
  id                String       @id @default(cuid())
  bookingId         String       @unique
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId        String
  traveler          User         @relation(fields: [travelerId], references: [id])
  tripTemplateId    String
  tripTemplate      TripTemplate @relation(fields: [tripTemplateId], references: [id], onDelete: Cascade)
  rating            Int // 1-5
  comment           String?      @db.Text
  response          String?      @db.Text
  isVerifiedBooking Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tripTemplateId])
  @@index([travelerId])
}

// Wishlist
model Wishlist {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripTemplateId String
  tripTemplate   TripTemplate @relation(fields: [tripTemplateId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, tripTemplateId])
  @@index([userId])
}

// Notification Preferences
model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentReminder     Boolean  @default(true)
  tripReminder        Boolean  @default(true)
  bookingConfirmation Boolean  @default(true)
  cancellationAlert   Boolean  @default(true)
  reviewRequest       Boolean  @default(true)
  smsNotifications    Boolean  @default(false)
  emailNotifications  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Notification Log
model NotificationLog {
  id               String           @id @default(cuid())
  userId           String
  notificationType NotificationType
  recipientEmail   String
  subject          String?
  message          String           @db.Text
  status           String // SENT, FAILED, BOUNCED
  sentAt           DateTime         @default(now())
  failureReason    String?
  metadata         Json?

  @@index([userId])
  @@index([sentAt])
}

// Payment Transactions
model PaymentTransaction {
  id            String        @id @default(cuid())
  bookingId     String
  amount        Float
  method        PaymentMethod
  transactionId String?
  status        String // INITIATED, SUCCESS, FAILED, PENDING
  provider      String? // CMI, STRIPE, PAYPAL, etc
  providerData  Json?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@index([transactionId])
}

// Conversations & Messages
model Conversation {
  id            String    @id @default(cuid())
  travelerId    String
  agencyId      String
  lastMessageAt DateTime?
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([travelerId, agencyId])
  @@index([travelerId])
  @@index([agencyId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String       @db.Text
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// Exchange Rates Cache
model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String   @default("MAD")
  targetCurrency String
  rate           Float
  lastUpdated    DateTime @default(now())
  expiresAt      DateTime

  @@unique([baseCurrency, targetCurrency])
  @@index([expiresAt])
}
