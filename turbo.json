{
    "$schema": "https://turborepo.org/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "db:generate": {
            "cache": false
        },
        "dev": {
            "cache": false
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ],
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "^test"
            ],
            "outputs": []
        }
    }
}
